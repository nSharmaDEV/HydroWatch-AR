# Local default. For approved hosting, use the EXACT public HTTPS origin, no trailing slash.
WATER_ALERT_ORIGIN=http://localhost:5178
HOST=127.0.0.1
PORT=8788
# Default is this app's data/live directory. Production needs a durable isolated disk.
# WATER_ALERT_DATA_DIR=/var/lib/water-alert
# Keep disabled until explicit authorization for keys, browser push services and device testing.
WATER_ALERT_PUSH_ENABLED=false
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your-approved-contact@example.org
# Optional approved cloud setup; see FREE-HOSTING.md. Never expose URLs/keys via VITE_*.
# WATER_ALERT_CLOUD_ENABLED=false
# DATABASE_URL=
# DATABASE_URL_ADMIN=
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# CRON_SECRET=
